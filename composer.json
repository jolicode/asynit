{
    "name": "jolicode/asynit",
    "description": "Asynchronous HTTP Request Testing Library for API or more...",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Joel Wurtz",
            "email": "joel.wurtz@gmail.com"
        }
    ],
    "bin": [
        "bin/asynit"
    ],
    "autoload": {
        "psr-4": {
            "Asynit\\": "src/"
        },
        "classmap": [
            "src/PHPUnit/Override/"
        ],
        "exclude-from-classmap": [
            "vendor/phpunit/phpunit/src/Framework/TestCase/OutputBuffer.php",
            "vendor/phpunit/phpunit/src/Framework/TestRunner/TestRunner.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Asynit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "bin/asynit tests/"
    },
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.0",
        "amphp/http-client": "^v5.0.1",
        "amphp/sync": "^2.0",
        "phpunit/phpunit": "~13.2.0",
        "symfony/console": "^5.4 || ^6.4 || ^7.4 || ^8.0",
        "symfony/finder": "^5.4 || ^6.4 || ^7.4 || ^8.0"
    },
    "suggest": {
        "amphp/http-client": "To use the web test case trait"
    },
    "conflict": {
        "amphp/byte-stream": "<2.1",
        "amphp/http": "<2.1"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpunit/phpunit": true
        }
    }
}
